# Force LF line endings for shell scripts (prevents Docker failures on Windows)
*.sh text eol=lf
*.bash text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf

# Keep these as auto
*.py text eol=auto
*.js text eol=auto
*.jsx text eol=auto
*.json text eol=auto
*.md text eol=auto
*.css text eol=auto
*.html text eol=auto
