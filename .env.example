# ═══════════════════════════════════════════════════════════════════════
#  Voice Spark AI — Environment Configuration
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════

# ─── General ──────────────────────────────────────────────────────────
DEBUG=false
SECRET_KEY=change-me-generate-a-long-random-string
ALLOWED_HOSTS=api.voicespark.ai,voicespark.ai,www.voicespark.ai,134-209-146-170.sslip.io,134.209.146.170,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://voicespark.ai,https://www.voicespark.ai,https://api.voicespark.ai,https://134-209-146-170.sslip.io,http://localhost,http://127.0.0.1
CSRF_TRUSTED_ORIGINS=https://voicespark.ai,https://www.voicespark.ai,https://api.voicespark.ai,https://134-209-146-170.sslip.io

# Public URL where the backend is reachable (used for media URLs)
BACKEND_URL=https://api.voicespark.ai
PUBLIC_BACKEND_URL=https://api.voicespark.ai

# ─── Database (PostgreSQL) ────────────────────────────────────────────
POSTGRES_DB=voicespark
POSTGRES_USER=voicespark
POSTGRES_PASSWORD=change-me-use-a-strong-password

# These connect Django to the PostgreSQL container
DB_NAME=voicespark
DB_USER=voicespark
DB_PASSWORD=change-me-use-a-strong-password
DB_HOST=postgres
DB_PORT=5432
DB_SSL_MODE=disable

# ─── Redis ────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=django-db

# ─── Celery ───────────────────────────────────────────────────────────
# Enable Celery for content engine tasks (recommended for Docker)
CONTENT_ENGINE_USE_CELERY=true

# ─── AI / LLM ─────────────────────────────────────────────────────────
GEMINI_API_KEY=your-google-gemini-api-key
# Optional: override default model
# GEMINI_TEXT_MODEL=gemini-2.5-flash

# Legacy — only needed if any feature still references OpenAI
# OPENAI_API_KEY=

# ─── Image Generation (NanoBanana) ────────────────────────────────────
# Required for AI image generation features
NANOBANANA_API_KEY=your-nanobanana-api-key

# ─── Encryption ───────────────────────────────────────────────────────
# Used by X/Twitter and WordPress token encryption
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=generate-a-fernet-key

# ─── Storage (Optional — defaults to local filesystem) ────────────────
# Uncomment and fill to use AWS S3 for media storage:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=us-east-1

# ─── Meta / Facebook / Instagram OAuth (Optional) ────────────────────
# Create a Meta App at https://developers.facebook.com
# META_APP_ID=
# META_APP_SECRET=
# META_REDIRECT_URI=http://localhost/auth/fb/callback
# INSTAGRAM_REDIRECT_URI=http://localhost/auth/fb/callback
# FACEBOOK_CONFIG_ID=
# INSTAGRAM_CONFIG_ID=

# ─── LinkedIn OAuth (Optional) ───────────────────────────────────────
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_REDIRECT_URI=http://localhost/auth/linkedin/callback/

# ─── X / Twitter OAuth (Optional) ────────────────────────────────────
# Create a project at https://developer.x.com
# OAuth 2.0 credentials
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# X_REDIRECT_URI=http://localhost/auth/x/callback/
# OAuth 1.0a credentials (required for media uploads)
# X_CONSUMER_KEY=
# X_CONSUMER_SECRET=
# X_OAUTH1_CALLBACK=http://localhost/auth/x/callback/
# Optional: override default scopes
# X_OAUTH_SCOPES=tweet.read tweet.write users.read offline.access media.write

# ─── Frontend ─────────────────────────────────────────────────────────
VITE_BACKEND_SERVER=https://api.voicespark.ai/
VITE_SCRAPER_BACKEND_SERVER=https://api.voicespark.ai/

# ─── Gunicorn (Optional) ─────────────────────────────────────────────
# GUNICORN_WORKERS=3
# GUNICORN_TIMEOUT=120

# ─── Feature Flags ───────────────────────────────────────────────────
ADVANCED_PIPELINE_ENABLED=false
